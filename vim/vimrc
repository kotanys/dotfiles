set nocompatible

colorscheme mysorbet
set nu rnu

set mouse=a

set showcmd

set autoindent
syntax on
filetype plugin indent on
set tabstop=4
set shiftwidth=4
set expandtab
set ignorecase
set smartcase
set incsearch
set nowrap

if has('gui')
    set guioptions -=m
    set guioptions -=T
    let &guifont="CaskaydiaCove Nerd Font Mono 14"
endif

let g:mapleader = ' '
nnoremap <Leader>vw <cmd>set invwrap<CR>
