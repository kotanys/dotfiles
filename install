#!/usr/bin/env bash

# Dotfile installer
# Invoking `./install ACTION` calls install_ACTION function
# if it exists or gives off a warning
#
# To extend, define install_ACTION functions or
# append to following arrays:

# Create a symlink at VALUE targeting KEY
declare -A LN_PKGS=(
    [mpv]="$HOME/.config/mpv"
    [vim]="$HOME/.config/vim"
    [kitty]="$HOME/.config/kitty"
    [bashrc]="$HOME/.bashrc"
    [skills]="$HOME/.config/opencode/skills"
    [nvim]="$HOME/.config/nvim"
)
# Copy KEY to VALUE
declare -A COPY_PKGS=(
    [htoprc]="$HOME/.config/htop/htoprc"
)

main() {
    local install_actions=()
    IFS=$'\n' read -d '' -r -a install_actions < <(
        declare -F | sed -n 's/declare -f install_\(.*\)$/\1/p'
    )

    if $HELP || (( "$#" == 0 )); then
        echo   "$0: $0 [options...] [actions...] "
        echo   '    Options:'
        echo  $'      -y\tsay yes to all prompts'
        echo  $'      -h\tprint this help and exit'
        echo
        echo   '    Actions:'
        printf '      %s\n' "${install_actions[@]}" | sort
        return
    fi

    local action
    for action in "$@"; do
        if printf "%s\0" "${install_actions[@]}" | grep -Fxqz -- "$action"; then
            eval "install_$action"
        else
            echo "warning: can't install '$action'" >&2
        fi
    done
}

fatal() {
    echo "$*"
    exit 1
} >&2

for pkg in "${!LN_PKGS[@]}"; do
    eval "
        install_$pkg() {
            ask-symlink \"$pkg\" \"${LN_PKGS[$pkg]}\"
        }
    "
done
for pkg in "${!COPY_PKGS[@]}"; do
    eval "
        install_$pkg() {
            ask-copy \"$pkg\" \"${COPY_PKGS[$pkg]}\"
        }
    "
done
unset pkg

if command -v go &>/dev/null; then
    install_turn_off_go_telemetry() {
        echo -n "Turn off go telemetry"
        ask-yn && {
            mkdir -p "$HOME/.config/go/telemetry" && {
                echo -n 'off '
                date +%Y-%m-%d
            } > "$HOME/.config/go/telemetry/mode"
        }
    }
fi

install_xcompose() {
    local composepath=$(realpath ./XCompose/XCompose)
    composepath=${composepath/#"$HOME"/'%H'}
    echo -n "Create ~/.XCompose that includes $composepath"
    ask-yn && {
        if [[ -e ~/.XCompose ]]; then
            echo "Refusing to override ~/.XCompose" >&2
            echo "include \"$composepath\""
        else
            echo "include \"$composepath\"" > ~/.XCompose
        fi
    }
}

YES=false
HELP=false
ARGS_BAD=false
while getopts yh getopt_arg; do
    case "$getopt_arg" in
    y)
        YES=true
        ;;
    h)
        HELP=true
        ;;
    '?' | :)
        ARGS_BAD=true
        ;;
    esac
done
$ARGS_BAD && fatal "bad cmdline args"
shift $((OPTIND - 1))

ask-yn() {
    $YES && { echo; return 0; }

    local yn
    while read -r -p "? [yN]: " yn; do
        [[ $yn =~ [Yy].* ]] && return 0
        [[ $yn =~ [Nn].* || -z $yn ]] && return 1
    done
}

ask-symlink() {
    local target=$1
    local link_name=$2
    echo -n "symlink $link_name to $target"
    ask-yn && {
        mkdir -p "$(dirname "$link_name")"
        ln -sf "$(realpath "$target")" "$link_name"
    }
    $YES && echo
}

ask-copy() {
    local source=$1
    local target=$2
    echo -n "copy $source to $target"
    ask-yn && {
        mkdir -p "$(dirname "$target")"
        cp -rL "$source" "$target"
    }
    $YES && echo
}

(return &>/dev/null) || {
    cd "$(dirname "$(realpath "$0")")" || exit 1
    main "$@"
}
